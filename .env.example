# =====================================================================
#  CẤU HÌNH MÔI TRƯỜNG - GẠO XƯỚNG HƯƠNG
#  Sao chép file này thành .env và điền thông tin thật:  cp .env.example .env
# =====================================================================

# Cổng chạy server
PORT=3000

# Môi trường: development | production
NODE_ENV=development

# --- Kết nối MySQL ---
# Nếu chưa cấu hình DB, form vẫn hoạt động và lưu tạm vào data/contacts.jsonl
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gao_xuong_huong

# --- Trang quản trị xem liên hệ (Basic Auth) ---
ADMIN_USER=admin
ADMIN_PASSWORD=doimatkhaungay

# --- Thông tin liên hệ hiển thị trên web (có thể đổi nhanh ở đây) ---
SITE_HOTLINE=0935999087
SITE_ZALO=0905057146
SITE_EMAIL=gaodanang@gmail.com
SITE_ADDRESS=111 Nguyễn Chí Diễu, Đà Nẵng

# --- Gửi email thông báo khi có khách để lại form ---
# Để TRỐNG các dòng SMTP_* nếu chưa cần gửi email -> hệ thống chạy chế độ
# "mô phỏng" (in nội dung email ra console). Khi sẵn sàng gửi thật, điền:
#   Gmail: tạo "Mật khẩu ứng dụng" 16 ký tự tại https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Email nhận thông báo (mặc định lấy theo SITE_EMAIL)
MAIL_TO=gaodanang@gmail.com
MAIL_FROM="Website Gạo Xướng Hương" <gaodanang@gmail.com>
