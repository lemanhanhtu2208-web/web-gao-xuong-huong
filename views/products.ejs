<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <!-- ===================== PAGE HERO ===================== -->
  <section class="page-hero">
    <div class="page-hero-bg" style="background-image:url('/img/san-pham-banner.jpg')"></div>
    <div class="page-hero-overlay"></div>
    <div class="container mx-auto relative z-10 text-cream text-center py-20 md:py-28">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang chủ</a> <span>/</span> <span>Sản phẩm</span>
      </nav>
      <h1 class="hero-fade font-serif text-4xl md:text-5xl font-extrabold text-shadow" style="--d:.1s">5 Dòng Gạo Chủ Lực Của Xướng Hương</h1>
      <p class="hero-fade mt-4 text-cream/90 max-w-2xl mx-auto text-shadow" style="--d:.25s">Từ bữa cơm gia đình đến bếp ăn nhà hàng – luôn có lựa chọn phù hợp với mức giá tận gốc.</p>
    </div>
  </section>

  <!-- ===================== LỜI DẪN + GIÁ ===================== -->
  <section class="py-12 bg-white border-b border-border-soft">
    <div class="container mx-auto grid md:grid-cols-3 gap-6 text-center">
      <div class="flex items-center justify-center gap-3" data-reveal><span class="text-3xl">💰</span><p class="text-text-soft text-sm text-left">Giá tận xưởng,<br /><strong class="text-primary">không qua trung gian</strong></p></div>
      <div class="flex items-center justify-center gap-3" data-reveal data-delay="100"><span class="text-3xl">📦</span><p class="text-text-soft text-sm text-left">Đóng gói linh hoạt<br /><strong class="text-primary">5kg · 10kg · 25kg · 50kg</strong></p></div>
      <div class="flex items-center justify-center gap-3" data-reveal data-delay="200"><span class="text-3xl">🚚</span><p class="text-text-soft text-sm text-left">Giao hàng tận nơi<br /><strong class="text-primary">khắp Đà Nẵng</strong></p></div>
    </div>
  </section>

  <!-- ===================== LƯỚI SẢN PHẨM ===================== -->
  <section class="py-16 md:py-24 grain-pattern">
    <div class="container mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-7">
        <% categories.forEach(function(cat, i){ %>
          <article class="product-card card-hover bg-white rounded-2xl overflow-hidden border border-border-soft flex flex-col" data-reveal data-delay="<%= (i%3)*100 %>">
            <a href="/san-pham/<%= cat.slug %>" class="block relative h-56 overflow-hidden">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy"
                   class="product-img w-full h-full object-cover" onerror="this.src='/img/placeholder.svg'" />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-white/90 text-primary text-xs font-semibold backdrop-blur"><%= cat.icon %> <%= cat.shortName %></span>
            </a>
            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-bold text-xl text-primary mb-2"><a href="/san-pham/<%= cat.slug %>" class="hover:text-secondary transition"><%= cat.name %></a></h2>
              <p class="text-text-soft text-sm mb-3 flex-1"><%= cat.tagline %></p>
              <div class="flex flex-wrap gap-1.5 mb-4">
                <% cat.highlights.forEach(function(h){ %>
                  <span class="px-2.5 py-1 rounded-full bg-accent-soft text-primary-dark text-xs font-medium"><%= h %></span>
                <% }); %>
              </div>
              <p class="text-xs text-text-soft mb-4"><strong>Quy cách:</strong> <%= cat.packaging.join(' · ') %></p>
              <div class="mt-auto flex gap-2">
                <a href="/san-pham/<%= cat.slug %>" class="flex-1 text-center px-4 py-3 rounded-full border-2 border-primary text-primary font-semibold hover:bg-primary hover:text-cream transition">Chi tiết</a>
                <a href="/lien-he?sp=<%= cat.slug %>" class="flex-1 text-center px-4 py-3 rounded-full bg-accent text-primary-dark font-semibold hover:brightness-105 transition">Báo giá</a>
              </div>
            </div>
          </article>
        <% }); %>
      </div>

      <!-- Lưu ý giá -->
      <div class="mt-12 bg-white rounded-2xl border border-border-soft p-6 md:p-8 text-center max-w-3xl mx-auto" data-reveal>
        <p class="text-text-soft">
          <span class="text-xl">💡</span> Tất cả sản phẩm <strong class="text-primary">không niêm yết giá công khai</strong>.
          Vui lòng bấm <strong>"Liên hệ nhận báo giá"</strong>, gọi
          <a href="tel:<%= site.hotline %>" class="text-primary font-semibold underline-offset-2 hover:underline">Hotline <%= site.hotlinePretty %></a>
          hoặc nhắn <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="text-zalo font-semibold underline-offset-2 hover:underline">Zalo <%= site.zaloPretty %></a>
          để nhận mức giá tận gốc tốt nhất theo số lượng.
        </p>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
