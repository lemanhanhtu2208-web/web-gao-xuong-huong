<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // Dữ liệu an toàn (phòng khi danh mục đến từ DB thiếu trường hiển thị)
  var gallery = (category.gallery && category.gallery.length) ? category.gallery : [category.image];
  var ratings = category.ratings || [];
  var varieties = category.varieties || [];
  var longDesc = category.longDesc || [category.intro];
%>

<main>
  <!-- ===================== BREADCRUMB ===================== -->
  <div class="container mx-auto pt-8">
    <nav class="breadcrumb breadcrumb-dark" aria-label="breadcrumb">
      <a href="/">Trang chủ</a> <span>/</span>
      <a href="/san-pham">Sản phẩm</a> <span>/</span>
      <span><%= category.name %></span>
    </nav>
  </div>

  <!-- ===================== CHI TIẾT ===================== -->
  <section class="section-tight !pt-10">
    <div class="container mx-auto grid lg:grid-cols-2 gap-14">

      <!-- ===== SLIDER ẢNH ===== -->
      <div data-reveal>
        <div class="detail-slider" data-slider>
          <div class="slider-viewport glass !p-2">
            <div class="slider-track" data-track>
              <% gallery.forEach(function(src, i){ %>
                <div class="slider-slide">
                  <img src="<%= src %>" alt="<%= category.name %> - ảnh <%= i+1 %>" loading="<%= i===0 ? 'eager' : 'lazy' %>"
                       class="w-full h-[340px] md:h-[480px] object-cover rounded-[1.4rem]" onerror="this.src='/img/placeholder.svg'" />
                </div>
              <% }); %>
            </div>

            <% if (gallery.length > 1) { %>
              <button type="button" class="slider-btn slider-prev" data-prev aria-label="Ảnh trước">‹</button>
              <button type="button" class="slider-btn slider-next" data-next aria-label="Ảnh sau">›</button>
              <div class="slider-dots" data-dots>
                <% gallery.forEach(function(src, i){ %>
                  <button type="button" class="slider-dot <%= i===0 ? 'active' : '' %>" data-go="<%= i %>" aria-label="Tới ảnh <%= i+1 %>"></button>
                <% }); %>
              </div>
            <% } %>

            <span class="absolute top-5 left-5 z-10 px-3 py-1 rounded-full glass-strong text-primary-dark text-xs font-medium"><%= category.icon %> <%= category.shortName %></span>
          </div>

          <% if (gallery.length > 1) { %>
            <div class="slider-thumbs" data-thumbs>
              <% gallery.forEach(function(src, i){ %>
                <button type="button" class="slider-thumb <%= i===0 ? 'active' : '' %>" data-go="<%= i %>">
                  <img src="<%= src %>" alt="thumbnail <%= i+1 %>" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ===== THÔNG TIN ===== -->
      <div data-reveal data-delay="120">
        <span class="eyebrow"><%= category.shortName %></span>
        <h1 class="section-title !mb-3"><%= category.name %></h1>
        <p class="text-xl font-display italic text-accent-dark mb-5"><%= category.tagline %></p>
        <p class="text-text-soft font-light leading-relaxed mb-8 measure"><%= category.intro %></p>

        <!-- Bảng thông số đặc tính -->
        <% if (ratings.length) { %>
          <div class="glass p-7 mb-8">
            <h2 class="font-display text-2xl font-semibold text-primary-dark mb-5">Thông số đặc tính</h2>
            <div class="space-y-5">
              <% ratings.forEach(function(r){ %>
                <div class="flex items-center gap-4">
                  <span class="w-36 shrink-0 text-sm text-text-soft font-light"><%= r.label %></span>
                  <div class="flex-1 rating-track">
                    <span class="rating-bar" style="--w: <%= (r.score/5*100) %>%"></span>
                  </div>
                  <span class="w-10 text-right text-sm font-medium text-primary-dark"><%= r.score %>/5</span>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <!-- Đặc tính nhanh -->
        <div class="grid sm:grid-cols-2 gap-3 mb-8">
          <% category.features.forEach(function(f){ %>
            <div class="flex items-start gap-2.5 py-2 border-b border-[color:var(--glass-line-soft)]">
              <span class="text-accent-dark text-sm mt-1">✦</span>
              <span class="text-sm font-light"><strong><%= f.label %>:</strong> <span class="text-text-soft"><%= f.value %></span></span>
            </div>
          <% }); %>
        </div>

        <!-- Giá / CTA -->
        <div class="glass-dark p-8">
          <p class="text-cream/70 text-xs uppercase tracking-wide mb-1">Chính sách giá</p>
          <p class="font-display text-3xl font-semibold text-accent mb-1">Báo giá sỉ tận gốc</p>
          <p class="text-cream/70 font-light text-sm mb-6">Báo giá theo số lượng &amp; quy cách — nhanh trong ít phút.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-zalo flex-1">💬 Zalo <%= site.zaloPretty %></a>
            <a href="tel:<%= site.hotline %>" class="btn btn-accent flex-1">📞 <%= site.hotlinePretty %></a>
          </div>
          <a href="/lien-he?sp=<%= category.slug %>" class="block text-center mt-4 text-cream/75 text-sm hover:text-accent transition">Hoặc gửi yêu cầu qua form →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MÔ TẢ + GIỐNG GẠO + SIDEBAR ===================== -->
  <section class="section-tight !pt-0">
    <div class="container mx-auto grid lg:grid-cols-3 gap-8 items-start">

      <div class="lg:col-span-2 space-y-8">
        <div class="glass p-8 md:p-10" data-reveal>
          <h2 class="section-title !text-3xl !mb-6">Mô tả chi tiết</h2>
          <div class="space-y-5">
            <% longDesc.forEach(function(p){ %>
              <p class="text-text-soft font-light leading-relaxed"><%= p %></p>
            <% }); %>
          </div>
        </div>

        <% if (varieties.length) { %>
          <div class="glass p-8 md:p-10" data-reveal data-delay="80">
            <h2 class="section-title !text-3xl !mb-6">Các giống gạo tiêu biểu</h2>
            <div class="grid sm:grid-cols-2 gap-5">
              <% varieties.forEach(function(v, i){ %>
                <div class="flex gap-4">
                  <span class="font-display text-2xl font-semibold text-accent-dark shrink-0">0<%= i+1 %></span>
                  <div>
                    <h3 class="text-xl text-primary-dark mb-1"><%= v.name %></h3>
                    <p class="text-sm text-text-soft font-light leading-relaxed"><%= v.note %></p>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>

      <aside class="space-y-6 lg:sticky lg:top-28" data-reveal data-delay="160">
        <div class="glass p-7">
          <h3 class="font-display text-xl font-semibold text-primary-dark mb-2">🍳 Cách nấu ngon</h3>
          <p class="text-text-soft font-light text-sm leading-relaxed"><%= category.cooking %></p>
        </div>

        <div class="glass p-7">
          <h3 class="font-display text-xl font-semibold text-primary-dark mb-3">📦 Quy cách đóng gói</h3>
          <div class="flex flex-wrap gap-2">
            <% category.packaging.forEach(function(p){ %>
              <span class="px-3 py-1.5 rounded-full border border-[color:var(--glass-line-soft)] text-sm text-primary-dark"><%= p %></span>
            <% }); %>
          </div>
          <p class="text-xs text-text-soft font-light mt-4">Túi nhỏ 5kg cho gia đình · Bao 10–50kg cho khách sỉ.</p>
        </div>

        <div class="glass p-7">
          <h3 class="font-display text-xl font-semibold text-primary-dark mb-2">👥 Phù hợp với</h3>
          <p class="text-sm text-text-soft font-light leading-relaxed"><%= category.suitableFor %></p>
        </div>

        <div class="glass-dark p-7 text-center">
          <p class="font-display text-xl font-semibold text-accent mb-4">Cần báo giá ngay?</p>
          <div class="flex flex-col gap-3">
            <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-zalo">💬 Zalo <%= site.zaloPretty %></a>
            <a href="tel:<%= site.hotline %>" class="btn btn-accent">📞 <%= site.hotlinePretty %></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== SẢN PHẨM LIÊN QUAN ===================== -->
  <section class="section-tight">
    <div class="container mx-auto">
      <div class="text-center mb-14" data-reveal>
        <span class="eyebrow centered">Khám phá thêm</span>
        <h2 class="section-title">Các dòng gạo khác</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <% related.forEach(function(cat, i){ %>
          <article class="glass glass-card overflow-hidden flex flex-col" data-reveal data-delay="<%= i*100 %>">
            <a href="/san-pham/<%= cat.slug %>" class="media media-zoom block h-52 !rounded-none">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
            </a>
            <div class="p-7 flex flex-col flex-1">
              <h3 class="text-2xl text-primary-dark mb-2"><a href="/san-pham/<%= cat.slug %>" class="hover:text-accent-dark transition"><%= cat.name %></a></h3>
              <p class="text-text-soft font-light text-[0.95rem] mb-6 flex-1 leading-relaxed"><%= cat.tagline %></p>
              <a href="/san-pham/<%= cat.slug %>" class="btn btn-ghost !py-3 text-sm">Xem chi tiết</a>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
