<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  var gallery = (category.gallery && category.gallery.length) ? category.gallery : [category.image];
  var ratings = category.ratings || [];
  var varieties = category.varieties || [];
  var longDesc = category.longDesc || [category.intro];
%>

<main>
  <!-- ===================== BREADCRUMB ===================== -->
  <div class="container mx-auto pt-10">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">Trang chủ</a> <span>/</span>
      <a href="/san-pham">Sản phẩm</a> <span>/</span>
      <span class="text-rice-soft"><%= category.name %></span>
    </nav>
  </div>

  <!-- ===================== CHI TIẾT ===================== -->
  <section class="section-tight !pt-12">
    <div class="container mx-auto grid lg:grid-cols-2 gap-14">

      <!-- ===== SLIDER ===== -->
      <div data-reveal>
        <div class="detail-slider" data-slider>
          <div class="slider-viewport glass !p-2">
            <div class="slider-track" data-track>
              <% gallery.forEach(function(src, i){ %>
                <div class="slider-slide">
                  <img src="<%= src %>" alt="<%= category.name %> - ảnh <%= i+1 %>" loading="<%= i===0 ? 'eager' : 'lazy' %>"
                       class="w-full h-[360px] md:h-[520px] object-cover rounded-[1.1rem]" onerror="this.src='/img/placeholder.svg'" />
                </div>
              <% }); %>
            </div>
            <% if (gallery.length > 1) { %>
              <button type="button" class="slider-btn slider-prev" data-prev aria-label="Ảnh trước">‹</button>
              <button type="button" class="slider-btn slider-next" data-next aria-label="Ảnh sau">›</button>
              <div class="slider-dots" data-dots>
                <% gallery.forEach(function(src, i){ %>
                  <button type="button" class="slider-dot <%= i===0 ? 'active' : '' %>" data-go="<%= i %>" aria-label="Tới ảnh <%= i+1 %>"></button>
                <% }); %>
              </div>
            <% } %>
            <span class="absolute top-6 left-6 z-10 text-[0.68rem] uppercase tracking-[0.16em] text-gold-light"><%= category.shortName %></span>
          </div>
          <% if (gallery.length > 1) { %>
            <div class="slider-thumbs" data-thumbs>
              <% gallery.forEach(function(src, i){ %>
                <button type="button" class="slider-thumb <%= i===0 ? 'active' : '' %>" data-go="<%= i %>">
                  <img src="<%= src %>" alt="thumbnail <%= i+1 %>" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ===== THÔNG TIN ===== -->
      <div data-reveal data-delay="120">
        <span class="eyebrow"><%= category.shortName %></span>
        <h1 class="section-title !mb-4"><%= category.name %></h1>
        <p class="font-display text-2xl italic text-gold-light mb-6"><%= category.tagline %></p>
        <p class="muted font-light leading-relaxed mb-10 measure"><%= category.intro %></p>

        <% if (ratings.length) { %>
          <div class="glass p-8 mb-8">
            <h2 class="font-display text-2xl font-medium mb-6">Thông số đặc tính</h2>
            <div class="space-y-6">
              <% ratings.forEach(function(r){ %>
                <div class="flex items-center gap-5">
                  <span class="w-36 shrink-0 text-sm muted font-light"><%= r.label %></span>
                  <div class="flex-1 rating-track"><span class="rating-bar" style="--w: <%= (r.score/5*100) %>%"></span></div>
                  <span class="w-10 text-right text-sm text-gold"><%= r.score %>/5</span>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-1 mb-10">
          <% category.features.forEach(function(f){ %>
            <div class="flex items-start gap-3 py-3 border-b border-[color:var(--glass-line-soft)]">
              <span class="text-gold mt-1"><%- include('partials/icon', { name: 'spark', cls: 'ico', sw: 1.4 }) %></span>
              <span class="text-sm font-light"><strong><%= f.label %>:</strong> <span class="muted"><%= f.value %></span></span>
            </div>
          <% }); %>
        </div>

        <div class="glass-strong p-8">
          <p class="text-[0.68rem] uppercase tracking-[0.16em] muted mb-2">Chính sách giá</p>
          <p class="font-display text-3xl font-medium text-gold mb-2">Báo giá sỉ tận gốc</p>
          <p class="muted font-light text-sm mb-7">Báo giá theo số lượng &amp; quy cách — nhanh trong ít phút.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-zalo flex-1">Zalo <%= site.zaloPretty %></a>
            <a href="tel:<%= site.hotline %>" class="btn btn-gold flex-1"><%= site.hotlinePretty %></a>
          </div>
          <a href="/lien-he?sp=<%= category.slug %>" class="block text-center mt-5 muted text-sm hover:text-gold transition">Hoặc gửi yêu cầu qua form →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MÔ TẢ + GIỐNG + SIDEBAR ===================== -->
  <section class="section-tight !pt-0">
    <div class="container mx-auto grid lg:grid-cols-3 gap-8 items-start">

      <div class="lg:col-span-2 space-y-6">
        <div class="glass p-8 md:p-12" data-reveal>
          <h2 class="section-title !text-3xl !mb-8">Mô tả chi tiết</h2>
          <div class="space-y-6">
            <% longDesc.forEach(function(p){ %>
              <p class="muted font-light leading-relaxed"><%= p %></p>
            <% }); %>
          </div>
        </div>

        <% if (varieties.length) { %>
          <div class="glass p-8 md:p-12" data-reveal data-delay="80">
            <h2 class="section-title !text-3xl !mb-8">Các giống gạo tiêu biểu</h2>
            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-7">
              <% varieties.forEach(function(v, i){ %>
                <div class="flex gap-5">
                  <span class="index-num !text-3xl">0<%= i+1 %></span>
                  <div>
                    <h3 class="text-xl mb-1"><%= v.name %></h3>
                    <p class="text-sm muted font-light leading-relaxed"><%= v.note %></p>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>

      <aside class="space-y-5 lg:sticky lg:top-28" data-reveal data-delay="160">
        <div class="glass p-7">
          <h3 class="font-display text-xl font-medium mb-3">Cách nấu ngon</h3>
          <p class="muted font-light text-sm leading-relaxed"><%= category.cooking %></p>
        </div>
        <div class="glass p-7">
          <h3 class="font-display text-xl font-medium mb-4">Quy cách đóng gói</h3>
          <div class="flex flex-wrap gap-2">
            <% category.packaging.forEach(function(p){ %>
              <span class="px-3 py-1.5 rounded-full border border-[color:var(--glass-line-soft)] text-sm muted"><%= p %></span>
            <% }); %>
          </div>
          <p class="text-xs muted font-light mt-4">Túi nhỏ 5kg cho gia đình · Bao 10–50kg cho khách sỉ.</p>
        </div>
        <div class="glass p-7">
          <h3 class="font-display text-xl font-medium mb-3">Phù hợp với</h3>
          <p class="text-sm muted font-light leading-relaxed"><%= category.suitableFor %></p>
        </div>
        <div class="glass-strong p-7 text-center">
          <p class="font-display text-xl font-medium text-gold mb-5">Cần báo giá ngay?</p>
          <div class="flex flex-col gap-3">
            <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-zalo">Zalo <%= site.zaloPretty %></a>
            <a href="tel:<%= site.hotline %>" class="btn btn-gold"><%= site.hotlinePretty %></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== LIÊN QUAN ===================== -->
  <section class="section-tight">
    <div class="container mx-auto">
      <div class="text-center mb-16" data-reveal>
        <span class="eyebrow centered">Khám phá thêm</span>
        <h2 class="section-title">Các dòng gạo khác</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <% related.forEach(function(cat, i){ %>
          <article class="glass glass-card overflow-hidden flex flex-col" data-reveal data-delay="<%= i*100 %>">
            <a href="/san-pham/<%= cat.slug %>" class="media media-zoom block h-52 !rounded-none">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
            </a>
            <div class="p-8 flex flex-col flex-1">
              <h3 class="text-2xl mb-3"><a href="/san-pham/<%= cat.slug %>" class="hover:text-gold-light transition"><%= cat.name %></a></h3>
              <p class="muted font-light text-[0.95rem] mb-6 flex-1 leading-relaxed"><%= cat.tagline %></p>
              <a href="/san-pham/<%= cat.slug %>" class="link-arrow !text-[0.7rem]">Xem chi tiết <%- include('partials/icon', { name: 'arrow', cls: 'ico', sw: 1.6 }) %></a>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
