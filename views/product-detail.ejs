<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <!-- ===================== BREADCRUMB ===================== -->
  <div class="bg-cream-2 border-b border-border-soft">
    <div class="container mx-auto py-4">
      <nav class="breadcrumb breadcrumb-dark" aria-label="breadcrumb">
        <a href="/">Trang chủ</a> <span>/</span>
        <a href="/san-pham">Sản phẩm</a> <span>/</span>
        <span><%= category.name %></span>
      </nav>
    </div>
  </div>

  <!-- ===================== CHI TIẾT ===================== -->
  <section class="py-12 md:py-16 bg-white">
    <div class="container mx-auto grid lg:grid-cols-2 gap-12">
      <!-- Ảnh -->
      <div data-reveal>
        <div class="img-frame">
          <img src="<%= category.image %>" alt="<%= category.name %>" loading="lazy"
               class="w-full rounded-3xl shadow-soft object-cover h-[320px] md:h-[460px]" onerror="this.src='/img/placeholder.svg'" />
        </div>
        <div class="grid grid-cols-3 gap-3 mt-4">
          <% category.packaging.slice(0,3).forEach(function(p){ %>
            <div class="bg-cream rounded-xl border border-border-soft py-3 text-center text-sm font-semibold text-primary">📦 <%= p %></div>
          <% }); %>
        </div>
      </div>

      <!-- Thông tin -->
      <div data-reveal data-delay="120">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-soft text-primary-dark text-sm font-semibold mb-3"><%= category.icon %> <%= category.shortName %></span>
        <h1 class="font-serif text-3xl md:text-4xl font-extrabold text-primary mb-3"><%= category.name %></h1>
        <p class="text-lg text-secondary font-medium mb-4"><%= category.tagline %></p>
        <p class="text-text-soft leading-relaxed mb-6"><%= category.intro %></p>

        <!-- Đặc tính -->
        <div class="space-y-3 mb-7">
          <% category.features.forEach(function(f){ %>
            <div class="flex items-start gap-3 bg-cream rounded-xl p-4 border border-border-soft">
              <span class="text-accent text-xl mt-0.5">●</span>
              <span><strong class="text-primary"><%= f.label %>:</strong> <span class="text-text-soft"><%= f.value %></span></span>
            </div>
          <% }); %>
        </div>

        <!-- Cách nấu -->
        <div class="bg-accent-soft/60 rounded-xl p-5 mb-7 border border-accent/30">
          <h2 class="font-bold text-primary mb-1.5 flex items-center gap-2">🍳 Cách nấu ngon</h2>
          <p class="text-text-soft text-sm leading-relaxed"><%= category.cooking %></p>
        </div>

        <!-- Quy cách + đối tượng -->
        <div class="grid sm:grid-cols-2 gap-4 mb-8">
          <div class="bg-white rounded-xl p-4 border border-border-soft">
            <h3 class="text-sm font-bold text-primary mb-2">📦 Quy cách đóng gói</h3>
            <ul class="text-sm text-text-soft space-y-1">
              <% category.packaging.forEach(function(p){ %><li>• <%= p %></li><% }); %>
            </ul>
          </div>
          <div class="bg-white rounded-xl p-4 border border-border-soft">
            <h3 class="text-sm font-bold text-primary mb-2">👥 Phù hợp với</h3>
            <p class="text-sm text-text-soft leading-relaxed"><%= category.suitableFor %></p>
          </div>
        </div>

        <!-- Giá / CTA -->
        <div class="bg-primary text-cream rounded-2xl p-6">
          <p class="text-cream/85 text-sm mb-1">Chính sách giá</p>
          <p class="font-serif text-2xl font-bold text-accent mb-4">Liên hệ nhận báo giá tận gốc</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="tel:<%= site.hotline %>" class="btn-shine flex-1 text-center px-6 py-3.5 rounded-full bg-accent text-primary-dark font-bold hover:-translate-y-0.5 transition-transform">📞 <%= site.hotlinePretty %></a>
            <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="flex-1 text-center px-6 py-3.5 rounded-full bg-zalo text-white font-bold hover:-translate-y-0.5 transition-transform">💬 Chat Zalo</a>
          </div>
          <a href="/lien-he?sp=<%= category.slug %>" class="block text-center mt-3 text-cream/80 text-sm underline-offset-2 hover:text-accent hover:underline">Hoặc gửi yêu cầu báo giá qua form →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SẢN PHẨM LIÊN QUAN ===================== -->
  <section class="py-16 md:py-20 grain-pattern">
    <div class="container mx-auto">
      <div class="text-center mb-12" data-reveal>
        <span class="eyebrow">Khám phá thêm</span>
        <h2 class="section-title">Các Dòng Gạo Khác</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-7">
        <% related.forEach(function(cat, i){ %>
          <article class="product-card card-hover bg-white rounded-2xl overflow-hidden border border-border-soft flex flex-col" data-reveal data-delay="<%= i*100 %>">
            <a href="/san-pham/<%= cat.slug %>" class="block relative h-48 overflow-hidden">
              <img src="<%= cat.image %>" alt="<%= cat.name %>" loading="lazy"
                   class="product-img w-full h-full object-cover" onerror="this.src='/img/placeholder.svg'" />
            </a>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-bold text-lg text-primary mb-2"><a href="/san-pham/<%= cat.slug %>" class="hover:text-secondary transition"><%= cat.name %></a></h3>
              <p class="text-text-soft text-sm mb-4 flex-1"><%= cat.tagline %></p>
              <a href="/san-pham/<%= cat.slug %>" class="mt-auto text-center px-4 py-2.5 rounded-full border-2 border-primary text-primary font-semibold hover:bg-primary hover:text-cream transition">Xem chi tiết</a>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
