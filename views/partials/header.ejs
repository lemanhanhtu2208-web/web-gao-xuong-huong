  <!-- ===================== TOP BAR ===================== -->
  <div class="topbar hidden md:block text-[0.72rem] tracking-[0.14em] uppercase">
    <div class="container mx-auto flex items-center justify-between py-2.5">
      <p class="flex items-center gap-2">
        <%- include('icon', { name: 'pin', cls: 'ico', sw: 1.4 }) %>
        <span><%= site.address %></span>
        <span class="mx-3 opacity-30">·</span>
        <span>Mở cửa <%= site.openHours %></span>
      </p>
      <p class="flex items-center gap-6">
        <a href="mailto:<%= site.email %>" class="hover:text-gold transition-colors"><%= site.email %></a>
        <a href="tel:<%= site.hotline %>" class="text-rice hover:text-gold transition-colors">Hotline <%= site.hotlinePretty %></a>
      </p>
    </div>
  </div>

  <!-- ===================== HEADER ===================== -->
  <header id="site-header" class="sticky top-0 z-50">
    <div class="container mx-auto flex items-center justify-between py-6">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3.5 group">
        <span class="grid place-items-center w-11 h-11 rounded-full border border-[color:var(--glass-line)] text-gold transition-transform duration-500 group-hover:rotate-[8deg]">
          <%- include('icon', { name: 'leaf', cls: 'ico', sw: 1.4 }) %>
        </span>
        <span class="leading-none">
          <span class="brand-mark block text-2xl">Xướng Hương</span>
          <span class="block text-[9px] tracking-[0.32em] uppercase mt-1.5 muted"><%= site.slogan %></span>
        </span>
      </a>

      <!-- Desktop menu -->
      <nav class="hidden lg:flex items-center gap-9">
        <% const nav = [
          { href: '/', label: 'Trang chủ', key: 'home' },
          { href: '/gioi-thieu', label: 'Giới thiệu', key: 'about' },
          { href: '/san-pham', label: 'Sản phẩm', key: 'products' },
          { href: '/lien-he', label: 'Liên hệ', key: 'contact' }
        ]; %>
        <% nav.forEach(function(item){ %>
          <a href="<%= item.href %>" class="nav-link <%= page === item.key ? 'active' : '' %>">
            <%= item.label %>
            <span class="nav-underline <%= page === item.key ? 'active' : '' %>"></span>
          </a>
        <% }); %>
      </nav>

      <!-- Header CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-ghost !py-2.5 !px-6 text-[0.72rem]">Tư vấn Zalo</a>
        <a href="/lien-he" class="btn btn-gold !py-2.5 !px-6 text-[0.72rem]">Nhận báo giá</a>
      </div>

      <!-- Hamburger -->
      <button id="menu-btn" aria-label="Mở menu" aria-expanded="false" class="lg:hidden grid place-items-center w-11 h-11 rounded-full border border-[color:var(--glass-line)]">
        <span id="menu-icon" class="block w-5 h-px relative transition-all before:content-[''] before:absolute before:w-5 before:h-px before:-top-[7px] before:transition-all after:content-[''] after:absolute after:w-5 after:h-px after:top-[7px] after:transition-all"></span>
      </button>
    </div>

    <!-- Mobile drawer -->
    <nav id="mobile-menu" class="lg:hidden max-h-0 overflow-hidden glass-strong !rounded-none transition-all duration-300 ease-in-out">
      <div class="container mx-auto flex flex-col py-3">
        <a href="/" class="nav-link !text-sm py-4 border-b border-[color:var(--glass-line-soft)] <%= page==='home'?'active':'' %>">Trang chủ</a>
        <a href="/gioi-thieu" class="nav-link !text-sm py-4 border-b border-[color:var(--glass-line-soft)] <%= page==='about'?'active':'' %>">Giới thiệu</a>
        <a href="/san-pham" class="nav-link !text-sm py-4 border-b border-[color:var(--glass-line-soft)] <%= page==='products'?'active':'' %>">Sản phẩm</a>
        <a href="/lien-he" class="nav-link !text-sm py-4 <%= page==='contact'?'active':'' %>">Liên hệ</a>
        <div class="flex gap-3 py-5">
          <a href="tel:<%= site.hotline %>" class="btn btn-ghost flex-1">Gọi ngay</a>
          <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="btn btn-gold flex-1">Zalo</a>
        </div>
      </div>
    </nav>
  </header>
