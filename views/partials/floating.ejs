  <!-- ===================== NÚT LIÊN HỆ NỔI (DESKTOP) ===================== -->
  <div class="hidden lg:flex flex-col gap-3 fixed bottom-6 right-6 z-50">
    <a href="tel:<%= site.hotline %>" aria-label="Gọi Hotline"
       class="group relative grid place-items-center w-14 h-14 rounded-full bg-primary text-cream text-2xl shadow-lg hover:-translate-y-1 transition-transform">
      📞
      <span class="absolute right-16 whitespace-nowrap px-3 py-1.5 rounded-lg bg-primary text-cream text-sm opacity-0 -translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-all"><%= site.hotlinePretty %></span>
    </a>
    <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" aria-label="Chat Zalo"
       class="group relative grid place-items-center w-14 h-14 rounded-full bg-zalo text-white text-2xl shadow-lg pulse-ring hover:-translate-y-1 transition-transform">
      💬
      <span class="absolute right-16 whitespace-nowrap px-3 py-1.5 rounded-lg bg-zalo text-white text-sm opacity-0 -translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-all">Chat Zalo</span>
    </a>
  </div>

  <!-- ===================== BACK TO TOP ===================== -->
  <button id="back-to-top" aria-label="Lên đầu trang" title="Lên đầu trang">↑</button>

  <!-- ===================== STICKY BAR (MOBILE) ===================== -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 grid grid-cols-3 glass-strong !rounded-none border-t border-[color:var(--glass-line)]">
    <a href="tel:<%= site.hotline %>" class="flex flex-col items-center justify-center gap-0.5 py-3 text-primary-dark font-medium text-sm">
      <span class="text-xl">📞</span> Gọi ngay
    </a>
    <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="flex flex-col items-center justify-center gap-0.5 py-3 text-zalo font-medium text-sm border-x border-[color:var(--glass-line-soft)]">
      <span class="text-xl">💬</span> Chat Zalo
    </a>
    <a href="/lien-he" class="flex flex-col items-center justify-center gap-0.5 py-3 text-secondary font-medium text-sm">
      <span class="text-xl">📝</span> Báo giá
    </a>
  </div>
