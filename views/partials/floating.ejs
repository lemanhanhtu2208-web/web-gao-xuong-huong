  <!-- ===================== NÚT LIÊN HỆ NỔI (DESKTOP) ===================== -->
  <div class="hidden lg:flex flex-col gap-3 fixed bottom-6 right-6 z-50">
    <a href="tel:<%= site.hotline %>" aria-label="Gọi Hotline" class="fab group">
      <%- include('icon', { name: 'phone', cls: 'ico', sw: 1.5 }) %>
      <span class="absolute right-[4.2rem] whitespace-nowrap px-3 py-1.5 rounded-lg glass-strong text-rice text-xs opacity-0 -translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-all"><%= site.hotlinePretty %></span>
    </a>
    <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" aria-label="Chat Zalo" class="fab fab-zalo pulse-ring group">
      <%- include('icon', { name: 'chat', cls: 'ico', sw: 1.5 }) %>
      <span class="absolute right-[4.2rem] whitespace-nowrap px-3 py-1.5 rounded-lg glass-strong text-rice text-xs opacity-0 -translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0 transition-all">Chat Zalo</span>
    </a>
  </div>

  <!-- ===================== BACK TO TOP ===================== -->
  <button id="back-to-top" aria-label="Lên đầu trang" title="Lên đầu trang">↑</button>

  <!-- ===================== STICKY BAR (MOBILE) ===================== -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 grid grid-cols-3 glass-strong !rounded-none border-t border-[color:var(--glass-line)]">
    <a href="tel:<%= site.hotline %>" class="flex flex-col items-center justify-center gap-1 py-3 text-rice text-[0.68rem] uppercase tracking-wider">
      <span class="text-gold"><%- include('icon', { name: 'phone', cls: 'ico', sw: 1.5 }) %></span> Gọi ngay
    </a>
    <a href="<%= site.zaloLink %>" target="_blank" rel="noopener" class="flex flex-col items-center justify-center gap-1 py-3 text-rice text-[0.68rem] uppercase tracking-wider border-x border-[color:var(--glass-line-soft)]">
      <span class="text-zalo"><%- include('icon', { name: 'chat', cls: 'ico', sw: 1.5 }) %></span> Chat Zalo
    </a>
    <a href="/lien-he" class="flex flex-col items-center justify-center gap-1 py-3 text-rice text-[0.68rem] uppercase tracking-wider">
      <span class="text-gold"><%- include('icon', { name: 'arrow', cls: 'ico', sw: 1.5 }) %></span> Báo giá
    </a>
  </div>
