<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <!-- ===================== PAGE HERO ===================== -->
  <section class="hero pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="container mx-auto relative z-10 text-center">
      <nav class="breadcrumb centered mb-8" aria-label="breadcrumb">
        <a href="/">Trang chủ</a> <span>/</span> <span>Giới thiệu</span>
      </nav>
      <span class="hero-fade eyebrow centered" style="--d:.05s">Câu chuyện thương hiệu</span>
      <h1 class="hero-fade display !text-[clamp(2.8rem,6.5vw,5.5rem)]" style="--d:.12s">Hơn một thập kỷ <em class="text-gold-light">cùng hạt gạo Việt</em></h1>
      <p class="hero-fade lead measure mx-auto mt-7" style="--d:.25s">Hành trình tận tâm, minh bạch và uy tín — từ một cơ sở nhỏ đến xưởng gạo của hàng trăm nhà hàng.</p>
    </div>
  </section>

  <!-- ===================== CÂU CHUYỆN ===================== -->
  <section class="section-tight">
    <div class="container mx-auto grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      <div data-reveal>
        <span class="eyebrow">Khởi nguồn</span>
        <h2 class="section-title">Hành trình của những hạt gạo sạch</h2>
        <p class="muted font-light leading-relaxed mb-6 measure">
          Giữa nhịp sống hối hả của Đà Nẵng, có một xưởng gạo vẫn ngày ngày lặng lẽ giữ trọn cái tâm
          với hạt gạo Việt — đó là <strong><%= site.name %></strong>. Khởi đầu từ một cơ sở kinh doanh
          gạo nhỏ với mong muốn giản dị <em>"mang hạt gạo sạch, ngon đến từng mâm cơm"</em>, Xướng Hương
          đã không ngừng lớn mạnh để trở thành địa chỉ cung ứng gạo uy tín hàng đầu miền Trung.
        </p>
        <p class="muted font-light leading-relaxed mb-6 measure">
          Người sáng lập hiểu rằng hạt gạo không chỉ là lương thực — đó là sức khỏe, là bữa cơm sum vầy
          của mỗi gia đình, là uy tín của mỗi nhà hàng. Vì lẽ đó, chúng tôi chọn một con đường không dễ
          dàng: <strong>chỉ cung cấp gạo sạch, nguồn gốc rõ ràng, chất lượng ổn định, giá minh bạch.</strong>
        </p>
        <p class="muted font-light leading-relaxed measure">
          Cái tên "Xướng Hương" — nơi hương thơm cất lên — cũng chính là lời cam kết về từng hạt gạo
          thơm dẻo mà chúng tôi gửi đến khách hàng.
        </p>
      </div>
      <div class="relative" data-reveal data-delay="120">
        <div class="media h-[400px] md:h-[540px]">
          <img src="/img/xuong-gao.jpg" alt="Xưởng gạo Xướng Hương" loading="lazy" onerror="this.src='/img/placeholder.svg'" />
        </div>
        <div class="glass-strong absolute -top-7 -left-2 md:-left-7 px-7 py-6">
          <span class="block index-num">2014</span>
          <span class="text-sm muted">năm khởi nghiệp</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== NĂNG LỰC ===================== -->
  <section class="section-tight">
    <div class="container mx-auto">
      <div class="measure mx-auto text-center mb-20" data-reveal>
        <span class="eyebrow centered">Năng lực thực sự</span>
        <h2 class="section-title">Lớn mạnh cùng năng lực &amp; sự tận tâm</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <% const caps = [
          { icon:'warehouse', title:'Kho bãi quy mô lớn', text:'Hệ thống kho bãi rộng rãi tại 111 Nguyễn Chí Diễu — khô ráo, thoáng mát, kiểm soát chặt chẽ để gạo luôn giữ trọn độ thơm ngon, không ẩm mốc, không mối mọt.' },
          { icon:'leaf', title:'Liên kết vùng nguyên liệu', text:'Làm việc trực tiếp với nông dân và các vùng trồng lúa trọng điểm, cắt bỏ hoàn toàn khâu trung gian để mang đến mức giá tận gốc tốt nhất.' },
          { icon:'truck', title:'Hàng trăm tấn mỗi tháng', text:'Mỗi tháng xưởng cung ứng hàng trăm tấn gạo cho nhà hàng, quán cơm, bếp ăn tập thể và hàng nghìn hộ gia đình trên khắp Đà Nẵng.' }
        ]; %>
        <% caps.forEach(function(c, i){ %>
          <div class="glass glass-card p-10" data-reveal data-delay="<%= i*110 %>">
            <span class="icon-frame mb-6"><%- include('partials/icon', { name: c.icon, cls: 'ico-lg', sw: 1.3 }) %></span>
            <h3 class="text-2xl mb-3"><%= c.title %></h3>
            <p class="muted font-light text-[0.95rem] leading-relaxed"><%= c.text %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ===================== TIMELINE ===================== -->
  <section class="section-tight">
    <div class="container mx-auto max-w-3xl">
      <div class="text-center mb-20" data-reveal>
        <span class="eyebrow centered">Chặng đường phát triển</span>
        <h2 class="section-title">Từ cơ sở nhỏ đến xưởng gạo uy tín</h2>
      </div>
      <div class="timeline">
        <% const milestones = [
          { year:'Khởi đầu', title:'Một cửa hàng gạo nhỏ', text:'Bắt đầu với mong muốn giản dị: mang hạt gạo sạch, ngon đến từng mâm cơm gia đình Đà Nẵng.' },
          { year:'Phát triển', title:'Mở rộng kho bãi', text:'Đầu tư hệ thống kho bãi quy mô lớn tại 111 Nguyễn Chí Diễu, chuẩn hóa quy trình bảo quản.' },
          { year:'Liên kết', title:'Bắt tay vùng nguyên liệu', text:'Liên kết trực tiếp với nông dân, kiểm soát chất lượng từ gốc, đưa giá về mức tận xưởng.' },
          { year:'Chứng nhận', title:'Đạt VietGAP & ATVSTP', text:'Hoàn thiện chứng nhận chất lượng, khẳng định cam kết gạo sạch — an toàn cho khách hàng.' },
          { year:'Hôm nay', title:'Đối tác của 300+ nhà hàng', text:'Cung ứng hàng trăm tấn gạo mỗi tháng cho nhà hàng, quán ăn và hàng nghìn hộ gia đình.' }
        ]; %>
        <% milestones.forEach(function(m, i){ %>
          <div class="timeline-item" data-reveal data-delay="<%= i*80 %>">
            <div class="timeline-dot"></div>
            <span class="text-[0.7rem] uppercase tracking-[0.2em] text-gold"><%= m.year %></span>
            <h3 class="text-2xl mt-2 mb-2"><%= m.title %></h3>
            <p class="muted font-light leading-relaxed"><%= m.text %></p>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ===================== CHỨNG NHẬN ===================== -->
  <section class="section-tight">
    <div class="container mx-auto">
      <div class="glass p-10 md:p-16 grid lg:grid-cols-2 gap-14 items-center">
        <div data-reveal>
          <span class="eyebrow">Cam kết chất lượng</span>
          <h2 class="section-title">Minh chứng bằng chứng nhận</h2>
          <p class="muted font-light leading-relaxed mb-8">
            Niềm tin của khách hàng là tài sản quý giá nhất của Xướng Hương. Toàn bộ quy trình từ
            tuyển chọn nguyên liệu, bảo quản đến đóng gói đều tuân thủ nghiêm ngặt các tiêu chuẩn an toàn.
          </p>
          <ul class="space-y-6">
            <li class="flex items-start gap-5"><span class="cert-badge">VietGAP</span><span class="muted font-light">Thực hành sản xuất nông nghiệp tốt — kiểm soát chất lượng theo tiêu chuẩn.</span></li>
            <li class="flex items-start gap-5"><span class="cert-badge">ATVSTP</span><span class="muted font-light">Giấy chứng nhận cơ sở đủ điều kiện An toàn Vệ sinh Thực phẩm.</span></li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-4" data-reveal data-delay="120">
          <div class="media h-44"><img src="/img/chung-nhan-vietgap.jpg" alt="Chứng nhận VietGAP" loading="lazy" onerror="this.src='/img/placeholder.svg'" /></div>
          <div class="media h-44"><img src="/img/chung-nhan-atvstp.jpg" alt="Chứng nhận ATVSTP" loading="lazy" onerror="this.src='/img/placeholder.svg'" /></div>
          <div class="media h-44"><img src="/img/kho-1.jpg" alt="Kho gạo thực tế" loading="lazy" onerror="this.src='/img/placeholder.svg'" /></div>
          <div class="media h-44"><img src="/img/kho-2.jpg" alt="Đóng gói gạo" loading="lazy" onerror="this.src='/img/placeholder.svg'" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CỘNG ĐỒNG + CTA ===================== -->
  <section class="section-tight">
    <div class="container mx-auto">
      <div class="glass-strong p-12 md:p-24 text-center measure mx-auto" data-reveal>
        <span class="eyebrow centered">Trách nhiệm cộng đồng</span>
        <h2 class="section-title">Đồng hành cùng cộng đồng</h2>
        <p class="muted font-light leading-relaxed mb-10">
          Không chỉ kinh doanh, Xướng Hương còn mong muốn lan tỏa giá trị tốt đẹp — luôn sẵn lòng đồng
          hành cùng các chương trình thiện nguyện với mức giá ưu đãi nhất. Bởi chúng tôi tin rằng, một
          hạt gạo sẻ chia cũng là một hạt gạo ý nghĩa.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/lien-he" class="btn btn-gold btn-lg">Nhận báo giá ngay</a>
          <a href="/san-pham" class="btn btn-ghost btn-lg">Xem sản phẩm</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
