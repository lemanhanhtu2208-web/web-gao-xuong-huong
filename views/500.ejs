<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="min-h-[70vh] grid place-items-center py-20">
  <div class="container mx-auto">
    <div class="glass-strong p-12 md:p-16 text-center max-w-lg mx-auto">
      <div class="text-6xl mb-4">🌾</div>
      <h1 class="display !text-7xl mb-3">500</h1>
      <p class="text-xl font-display italic text-accent-dark mb-3">Máy chủ đang gặp sự cố.</p>
      <p class="text-text-soft font-light mb-9">Xin lỗi vì sự bất tiện này. Vui lòng thử lại sau ít phút, hoặc gọi Hotline để được hỗ trợ ngay.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/" class="btn btn-primary">← Về trang chủ</a>
        <a href="tel:<%= site.hotline %>" class="btn btn-accent">📞 <%= site.hotlinePretty %></a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/scripts') %>
